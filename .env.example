# Backend
# Supabase Postgres. DATABASE_URL = transaction pooler (port 6543) for the app runtime;
# DIRECT_URL = session pooler (port 5432) for Prisma Migrate.
# Find both under: Supabase Dashboard -> project -> Connect.
# URL-encode special chars in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
REDIS_URL=
JWT_SECRET=

# Firebase (OTP auth)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Dev-only: used by `pnpm get-test-token` (Firebase client SDK). Project settings ->
# General -> your web app -> apiKey / authDomain. Not used by the app runtime.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Sentry (optional in dev — crash reporting is skipped when unset)
SENTRY_DSN=

# Maps
MAPS_API_KEY=

# Mobile apps
EXPO_PUBLIC_API_URL=http://localhost:4000
